{
  "name": "dsh-stock-ticker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Scrolling stock ticker strip above the DeepSeek Harness Web UI, with a customizable watchlist and refresh interval.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "stock",
    "ticker",
    "quote"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfat77/dsh-stock-ticker.git"
  },
  "homepage": "https://github.com/kfat77/dsh-stock-ticker",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
